#include <dt-bindings/led/led.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DVO     0
#define NAV     1
#define NUM     2
#define SYM     3
#define LOL     4

/ {
    macros {
        rgb_mo: rgb_mo {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_param_2to2 &rgb_ug RGB_COLOR_HSB_CMD MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(0,0,0)>;

            label = "RGB_MO";
        };

        rgb_toggle: rgb_toggle {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &to MACRO_PLACEHOLDER &macro_param_2to2 &rgb_ug RGB_COLOR_HSB_CMD MACRO_PLACEHOLDER>;

            label = "RGB_TOGGLE";
        };
    };

    combos {
        compatible = "zmk,combos";

        caps_word {
            bindings = <&caps_word>;
            key-positions = <30 29>;
            layers = <0>;
        };

        Numbers {
            bindings = <&rgb_toggle 2 RGB_COLOR_HSB_VAL(170,66,30)>;
            key-positions = <27 32>;
        };

        Symbols {
            bindings = <&rgb_toggle 3 RGB_COLOR_HSB_VAL(235,68,33)>;
            key-positions = <26 33>;
        };

        LoL {
            bindings = <&rgb_toggle 4 RGB_COLOR_HSB_VAL(293,100,32)>;
            key-positions = <25 34>;
        };

        Setup {
            bindings = <&rgb_toggle 5 RGB_COLOR_HSB_VAL(0,100,40)>;
            key-positions = <24 35>;
        };

        default {
            bindings = <&rgb_toggle 0 RGB_COLOR_HSB_VAL(0,0,0)>;
            key-positions = <0 11>;
        };

        Movements {
            bindings = <&rgb_toggle 1 RGB_COLOR_HSB_VAL(30,99,27)>;
            key-positions = <28 31>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // | ESC |  .  |  ,  |  Ñ  |  P  |  Y  |   |  F  |  G   |  C  |  H  |  L  | BKSP |
            // | TAB |  A  |  O  |  E  |  U  |  I  |   |  D  |  R   |  T  |  N  |  S  | SUP  |
            // | GUI |  '  |  Q  |  J  |  K  |  X  |   |  B  |  M   |  W  |  V  |  Z  | ´ ALT  |
            //                    | NUM | SPACE/NAV | CTRL |   | ENT | SYM  | SHIFT/LOCK |

            bindings = <
&kp ESC   &kp DOT    &kp COMMA  &kp SEMI                                &kp P        &kp Y        &kp F    &kp G                                    &kp C       &kp H  &kp L  &kp BSPC
&kp TAB   &kp A      &kp O      &kp E                                   &kp U        &kp I        &kp D    &kp R                                    &kp T       &kp N  &kp S  &kp DEL
&kp LGUI  &kp MINUS  &kp Q      &kp J                                   &kp K        &kp X        &kp B    &kp M                                    &kp W       &kp V  &kp Z  &mt LALT LBKT
                                &rgb_mo 2 RGB_COLOR_HSB_VAL(171,61,25)  &lt 1 SPACE  &kp LCTRL    &kp RET  &rgb_mo 3 RGB_COLOR_HSB_VAL(247,100,50)  &kp LSHIFT
            >;
        };

        nav_layer {
            // -----------------------------------------------------------------------------------------
            // | F1  |  F2 |  F3    |  F4   |  F5     |  F6  |   |  COPY  |  CUT     |  UP    |  PASTE  |  IMPPAGE  | BKSP |
            // | TAB |     |  CTRL  |  ALT  |  SHIFT  |      |   |  CTRL  |  LEFT    |  DOWN  |  RIGHT  |           | SUP  |
            // | F7  |  F8 |  F9    |  F10  |  F11    |  F12 |   |  PAUS  |  ANTER   |  PROX  |   MUTE  |  -SON     | +SON  |
            //                      | GUI   |     | SPACE/CTRL |   | ENT |           |  LOL   |

            bindings = <
&kp F1   &kp F2  &kp F3     &kp F4    &kp F5      &kp F6             &kp LC(C)  &kp LC(X)   &kp UP      &kp LC(V)   &kp PSCRN     &kp BSPC
&kp TAB  &none   &kp LCTRL  &kp LALT  &kp LSHIFT  &none              &kp LCTRL  &kp LEFT    &kp DOWN    &kp RIGHT   &none         &kp DEL
&kp F7   &kp F8  &kp F9     &kp F10   &kp F11     &kp F12            &kp C_PP   &kp C_PREV  &kp C_NEXT  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP
                            &kp LGUI  &trans      &mt LCTRL SPACE    &kp RET    &trans      &trans
            >;
        };

        num_layer {
            // -----------------------------------------------------------------------------------------
            // |  +BRI |  =  |  %  |  (   |   )  |  :  |     |  =  |  7  |  8  |  9  |  *  |  BKSP |
            // |  -BRI |  [  |  ]  |  {   |   }  |  ;  |     |  /  |  4  |  5  |  6  |  +  |  SUP  |
            // | BTRST |  B1 |  B2 |  B3  |  B4  |  B5 |     |  ,  |  1  |  2  |  3  |  -  | SHIFT |
            //                      |    |     | SPACE/CTRL |   | ENT |   .  |  0   |

            bindings = <
&trans  &kp RPAR   &mkp LCLK  &kp UP_ARROW    &mkp RCLK  &kp K_SCROLL_UP      &kp RPAR   &kp N7   &kp N8  &kp N9  &kp RBRC  &kp BSPC
&trans  &kp ASTRK  &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &kp K_SCROLL_DOWN    &kp AMPS   &kp N4   &kp N5  &kp N6  &kp RBKT  &kp DEL
&none   &kp LPAR   &kp SQT    &kp BSLH        &kp DQT    &kp TILDE2           &kp COMMA  &kp N1   &kp N2  &kp N3  &kp FSLH  &kp LEFT_SHIFT
                              &trans          &trans     &mt LCTRL SPACE      &kp RET    &kp DOT  &kp N0
            >;
        };

        sym_layer {
            // ----------------------------------------------------------------------------------------
            // |  |  |  =  |  %  |  (   |   )  |  ^  |     |  \  |  ¿  |  ?  |  <  |  *  |  BKSP |
            // | TAB |  @  |  "  |  {   |   }  |  `  |     |  /  |  ¡  |  !  |  >  |  +  |  SUP  |
            // |  ¨  |  $  |  &  |  [   |   ]  |  #  |     |  °  |  ~  |  ¬  |  _  |  -  | SHIFT |    
            //                      |  ;  |   :  | SPACE/CTRL |   | ENT |     |  ALT   |

            bindings = <
&kp GRAVE  &kp RPAR   &kp PRCNT  &kp ASTRK  &kp LPAR    &kp RA(APOS)       &kp RA(MINUS)  &kp EQUAL     &kp UNDER      &kp NON_US_BSLH  &kp RBRC  &kp BSPC
&kp TAB    &kp RA(Q)  &kp AT     &kp SQT    &kp BSLH    &kp RA(BSLH)       &kp AMPS       &kp PLUS      &kp EXCL       &kp RS(NUBS)     &kp RBKT  &kp DEL
&kp LBRC   &kp DLLR   &kp CARET  &kp DQT    &kp TILDE2  &kp HASH           &kp TILDE      &kp RA(RBKT)  &kp RA(GRAVE)  &kp QMARK        &kp FSLH  &kp LEFT_SHIFT
                                 &kp LT     &kp GT      &mt LCTRL SPACE    &kp RET        &trans        &kp LALT
            >;
        };

        lol_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC  |  1  | 2   |  3   |   4  |  5  |     |  F2 |  F3 |  F4 |  F5 |     |  BKSP |
            // |  TAB  |  Q  |  W  |  E   |   R  |  6  |     |  C  |  V  |  O  |  Y  |  S  |  SUP  |
            // |   G   |  P  |  B  |  D   |   F  |  M  |     |  L  |  H  |  Z  |  X  |     | SHIFT |
            //                      |  T  |   ENT  | SPACE |   | CTRL |  DVORAK   |  SHIFT   |

            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4   &kp N5       &kp F2     &kp F3  &kp F4      &kp F5  &none  &kp BSPC
&kp TAB  &kp Q   &kp W   &kp E   &kp R    &kp N6       &kp C      &kp V   &kp O       &kp Y   &kp S  &kp DEL
&kp G    &kp P   &kp B   &kp D   &kp F    &kp M        &kp L      &kp H   &kp Z       &kp X   &none  &none
                         &kp T   &kp RET  &kp SPACE    &kp LCTRL  &none   &kp LSHIFT
            >;
        };

        setup {
            bindings = <
&kp C_BRI_UP  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI     &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &bt BT_CLR
&kp C_BRI_DN  &rgb_ug RGB_EFR  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &out OUT_BLE
&kp C_VOL_UP  &kp C_VOL_DN     &kp C_MUTE       &kp C_REWIND     &kp C_FF         &rgb_ug RGB_TOG     &none          &none          &none          &none          &out OUT_USB   &out OUT_TOG
                                                &kp C_PREV       &kp C_NEXT       &kp C_PLAY_PAUSE    &kp C_POWER    &kp C_SLEEP    &kp C_RESET
            >;
        };
    };
};

&led_strip { chain-length = <27>; };
